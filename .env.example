# ==== Ambiente ====
# Valores válidos: development, production
LYNK_ENV=development

# Domínio da aplicação em produção (usado pelo Caddy para HTTPS automático)
LYNK_DOMAIN=lynk.example.com

# ==== Segurança ====
# Gere valores aleatórios de pelo menos 64 caracteres em produção.
# PowerShell: [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 }))
LYNK_SECRET_KEY=troque-me-em-producao-com-valor-aleatorio-longo
LYNK_CSRF_SECRET=troque-me-em-producao-com-outro-valor-aleatorio-longo

# Cookie de sessão
LYNK_SESSION_COOKIE_NAME=lynk_session
LYNK_SESSION_LIFETIME_MINUTES=720
LYNK_SESSION_IDLE_MINUTES=120

# ==== Banco de dados ====
POSTGRES_DB=lynk
POSTGRES_USER=lynk
POSTGRES_PASSWORD=troque-me
# Em produção mantenha o host = db (rede interna do Compose).
DATABASE_URL=postgresql+psycopg://lynk:troque-me@db:5432/lynk

# ==== Redis (sessões, cache e broker do Celery) ====
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==== Aplicação ====
LYNK_TIMEZONE=America/Sao_Paulo
LYNK_LOCALE=pt_BR

# Diariamente às 19h fecha as metas operacionais (RN-003)
LYNK_DAILY_METAS_CLOSE_HOUR=19

# ==== SMTP (opcional na V1) ====
LYNK_SMTP_HOST=
LYNK_SMTP_PORT=587
LYNK_SMTP_USERNAME=
LYNK_SMTP_PASSWORD=
LYNK_SMTP_FROM=

# ==== Gunicorn ====
LYNK_GUNICORN_WORKERS=3
LYNK_GUNICORN_TIMEOUT=60
